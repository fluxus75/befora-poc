# OpenAI API Configuration
OPENAI_API_KEY=your_key_here
OPENAI_ORG_ID=org-your-org-id-here
OPENAI_PROJECT_ID=proj-your-project-id-here

# Realtime API Settings
# Models: gpt-realtime (GA), gpt-4o-mini-realtime-preview (low-cost)
REALTIME_MODEL=gpt-realtime
# Voices: alloy, ash, ballad, coral, echo, sage, shimmer, verse, marin, cedar
REALTIME_VOICE=alloy
REALTIME_TEMPERATURE=0.8
REALTIME_MAX_TOKENS=4096
REALTIME_PROVIDER=openai
MOCK_SCENARIO_PATH=server/fixtures/mock_transcripts.json
MOCK_LATENCY_MS=500
LOCAL_STT_MODEL=base
LOCAL_TTS_ENGINE=browser
LOCAL_LLM_ENDPOINT=

# Frontend Realtime Provider
VITE_REALTIME_PROVIDER=mock
VITE_MOCK_SCENARIO=normal_flow
VITE_MOCK_LATENCY_MS=500
VITE_LOCAL_SAMPLE_RATE=16000

# Ephemeral Token Settings
EPHEMERAL_TOKEN_EXPIRE_SECONDS=60

# Database
DATABASE_URL=sqlite:///./befora.db
DB_ENCRYPTION_KEY=your_fernet_key_here

# General
DEBUG=true

# Dashboard
DASHBOARD_PORT=5174
DASHBOARD_DEFAULT_PASSWORD=change_me
JWT_SECRET=change_me
