#!/bin/bash

# Codex 브랜치인 경우에만 자동 PR 생성
BRANCH=$(git rev-parse --abbrev-ref HEAD)

if [[ "$BRANCH" == codex/* ]]; then
  echo "🤖 Codex branch detected: $BRANCH"
  echo "🔄 Creating PR automatically..."

  # Task 파일 찾기
  TASK_SUFFIX="${BRANCH#codex/}"
  TASK_FILE=$(find docs/tasks -name "*${TASK_SUFFIX}.md" | head -1)

  if [ -z "$TASK_FILE" ]; then
    echo "⚠️  Task file not found for branch: $BRANCH"
    echo "Skipping auto PR creation."
    exit 0
  fi

  # PR 생성 (gh CLI 사용)
  gh pr create \
    --title "feat: $(head -1 "$TASK_FILE" | sed 's/^# Task: //')" \
    --body "Auto-generated from task: $TASK_FILE" \
    --base main \
    --head "$BRANCH" \
    --label "autogenerated,needs-review" \
    || echo "⚠️  PR creation failed (may already exist)"

  echo "✅ PR created successfully!"
fi
